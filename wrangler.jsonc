{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somewhere-guest-world",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*","/socket","/health"]},
  "durable_objects": {"bindings":[{"name":"HUB","class_name":"GuestHub"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["GuestHub"]}],
  "observability": {"enabled":false}
}
